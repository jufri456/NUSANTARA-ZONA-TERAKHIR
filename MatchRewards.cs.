

using UnityEngine;

public class MatchRewards : MonoBehaviour
{
    public int coins;
    public int experience;

    public void GiveVictoryReward(PlayerProfile profile)
    {
        coins += 500;
        experience += 200;

        if (profile != null)
        {
            profile.AddExperience(200);
        }

        Debug.Log("BOOYAH REWARD!");
        Debug.Log("500 Koin dan 200 EXP");
    }

    public void GiveParticipationReward()
    {
        coins += 100;
        experience += 50;

        Debug.Log("Hadiah partisipasi diterima!");
    }
}
